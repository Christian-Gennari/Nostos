		<link href="https://standardebooks.org/ebooks/gustave-flaubert/sentimental-education/m-walter-dunne/downloads/gustave-flaubert_sentimental-education_m-walter-dunne.azw3?source=feed" length="1206314" rel="http://opds-spec.org/acquisition/open-access" title="Amazon Kindle azw3" type="application/x-mobipocket-ebook"/>

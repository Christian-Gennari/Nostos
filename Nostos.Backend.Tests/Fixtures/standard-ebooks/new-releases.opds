	<entry>
		<id>https://standardebooks.org/ebooks/dorothy-m-richardson/oberland</id>
		<dc:identifier>https://standardebooks.org/ebooks/dorothy-m-richardson/oberland</dc:identifier>
		<title>Oberland</title>
		<author>
			<name>Dorothy M. Richardson</name>
			<uri>https://standardebooks.org/ebooks/dorothy-m-richardson</uri>
			<schema:alternateName>Dorothy Miller Richardson</schema:alternateName>
			<schema:sameAs>https://en.wikipedia.org/wiki/Dorothy_M._Richardson</schema:sameAs>
			<schema:sameAs>https://id.loc.gov/authorities/names/n50051627.html</schema:sameAs>
		</author>
		<published>2026-10-01T21:12:31Z</published>
		<dc:issued>2026-10-01T21:12:31Z</dc:issued>
		<updated>2026-10-01T21:12:33Z</updated>
		<dc:language>en-GB</dc:language>
		<dc:publisher>Standard Ebooks</dc:publisher>
		<rights>Public domain in the United States. Users located outside of the United States must check their local laws before using this ebook. Original content released to the public domain via the Creative Commons CC0 1.0 Universal Public Domain Dedication.</rights>
		<summary type="text">An independent young woman from London is gifted a two week trip to a resort in Switzerland.</summary>
		<content type="html">&lt;p&gt;&lt;i&gt;Oberland&lt;/i&gt; is the ninth “chapter volume” of &lt;a href="https://standardebooks.org/ebooks/dorothy-m-richardson"&gt;Dorothy M. Richardson’s&lt;/a&gt; pioneering semi-autobiographical series, &lt;a href="https://standardebooks.org/collections/pilgrimage"&gt;Pilgrimage&lt;/a&gt;.&lt;/p&gt; &lt;p&gt;Series protagonist Miriam Henderson spends two weeks at the Hotel Alpenstock, a resort in the the Bernese Oberland region of Switzerland, mainly in the company of other English guests. In the evenings she watches how the relationships of these temporary groups emerge. During the day she explores the crisp beauty of the Alpine landscape and flings herself into winter sport, with the daily sunrise on the Alps becoming a character in its own right.&lt;/p&gt; &lt;p&gt;The book was inspired by a 1904 trip Richardson made to Adelboden, Switzerland, as a treat from her employer, Dr. J. H. Badcock.&lt;/p&gt;</content>
		<category scheme="http://purl.org/dc/terms/LCSH" term="Autobiographical fiction"/>
		<category scheme="http://purl.org/dc/terms/LCSH" term="Women--England--Fiction"/>
		<category scheme="http://purl.org/dc/terms/LCSH" term="England--Social life and customs--20th century--Fiction"/>
		<category scheme="https://standardebooks.org/vocab/subjects" term="Fiction"/>
		<link href="https://standardebooks.org/ebooks/dorothy-m-richardson/oberland/downloads/cover.jpg" rel="http://opds-spec.org/image" type="image/jpeg"/>

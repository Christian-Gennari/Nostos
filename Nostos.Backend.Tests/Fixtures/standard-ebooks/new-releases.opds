	<entry>
		<id>https://standardebooks.org/ebooks/george-macdonald/within-and-without</id>
		<dc:identifier>https://standardebooks.org/ebooks/george-macdonald/within-and-without</dc:identifier>
		<title>Within and Without</title>
		<author>
			<name>George MacDonald</name>
			<uri>https://standardebooks.org/ebooks/george-macdonald</uri>
			<schema:sameAs>https://en.wikipedia.org/wiki/George_MacDonald</schema:sameAs>
			<schema:sameAs>https://id.loc.gov/authorities/names/n78096948.html</schema:sameAs>
		</author>
		<published>2026-09-08T21:53:41Z</published>
		<dc:issued>2026-09-08T21:53:41Z</dc:issued>
		<updated>2026-09-08T21:59:59Z</updated>
		<dc:language>en-GB</dc:language>
		<dc:publisher>Standard Ebooks</dc:publisher>
		<rights>Public domain in the United States. Users located outside of the United States must check their local laws before using this ebook. Original content released to the public domain via the Creative Commons CC0 1.0 Universal Public Domain Dedication.</rights>
		<summary type="text">A spiritually unfulfilled monk goes on a journey to rescue a woman from his past.</summary>
		<content type="html">&lt;p&gt;Brother Julian is far from an exemplary monk: he takes no joy in monastery life, feels no connection with God, and continuously dwells on the mysterious life he left behind. When he learns that a woman from his past needs his help, he must choose between his duty to the Church and his duty to his conscience.&lt;/p&gt; &lt;p&gt;&lt;a href="https://standardebooks.org/ebooks/george-macdonald"&gt;George MacDonald’s&lt;/a&gt; earliest published work, and his only poetic drama, &lt;i&gt;Within and Without&lt;/i&gt; chronicles a monk’s journey to know God as he experiences love, death, and joy. Notably, it contains one of MacDonald’s earliest works of fantasy prose: a passage read by Julian from the fictitious book, &lt;i&gt;The Singer&lt;/i&gt;.&lt;/p&gt;</content>
		<category scheme="http://purl.org/dc/terms/LCSH" term="Christian poetry, Scottish"/>
		<category scheme="http://purl.org/dc/terms/LCSH" term="Scottish poetry--19th century"/>
		<category scheme="http://purl.org/dc/terms/LCSH" term="Verse drama, English"/>
		<category scheme="https://standardebooks.org/vocab/subjects" term="Drama"/>
		<link href="https://standardebooks.org/ebooks/george-macdonald/within-and-without/downloads/cover.jpg" rel="http://opds-spec.org/image" type="image/jpeg"/>

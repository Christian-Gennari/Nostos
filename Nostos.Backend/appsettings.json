{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackupSettings": {
    "IsEnabled": false,
    "IntervalHours": 168,
    "Provider": "Local",
    "MaxBackups": 3,
    "IncludeBookFiles": true
  },
  "ReadAloud": {
    "Enabled": false,
    "BaseUrl": "",
    "Model": "kokoro",
    "ApiKeyEnvironmentVariable": "NOSTOS_READ_ALOUD_TOKEN",
    "MaxCharacters": 1200,
    "RequestTimeoutSeconds": 60,
    "CacheDirectory": "",
    "CacheMaxBytes": 536870912
  },
  "Speech": {
    "Enabled": true,
    "BaseUrl": "",
    "Model": "groq/whisper-large-v3-turbo",
    "ApiKeyEnvironmentVariable": "NOSTOS_STT_TOKEN",
    "MaxUploadBytes": 26214400,
    "MaxDurationSeconds": 300
  },
  "Embedding": {
    "Enabled": true,
    "BaseUrl": "",
    "Model": "alibaba/qwen3-embedding-0-6b",
    "ApiKeyEnvironmentVariable": "NOSTOS_EMBEDDING_TOKEN",
    "RequestTimeoutSeconds": 60
  },
  "Assistant": {
    "Enabled": true,
    "BaseUrl": "",
    "Model": "gemini/gemini-3.5-flash-lite",
    "ApiKeyEnvironmentVariable": "NOSTOS_ASSISTANT_TOKEN",
    "MaxToolIterations": 12,
    "RequestTimeoutSeconds": 95
  },
  "LibraryReceiptRetention": {
    "RetentionDays": 90,
    "MaximumReceipts": 10000,
    "CleanupIntervalHours": 24
  },
  "ProviderDiscovery": {
    "SearchTimeout": "00:00:12",
    "AggregateSearchTimeout": "00:00:04"
  },
  "Persistence": {
    "DatabasePath": null
  },
  "Storage": {
    "BooksRoot": null,
    "BackupsRoot": null
  }
}

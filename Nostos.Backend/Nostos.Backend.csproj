<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\Nostos.Frontend\</SpaRoot>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Security overrides for vulnerable transitives:
         Microsoft.OpenApi 2.0.0 -> 2.7.5 (GHSA-v5pm-xwqc-g5wc)
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 -> 3.53.3 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageReference Include="z440.atl.core" Version="7.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Product\Nostos.Product.csproj" />
    <ProjectReference Include="..\Nostos.Shared\Nostos.Shared.csproj" />
  </ItemGroup>

  <!--
    Canonical product source is compiled by Nostos.Product. The 02.2 foundation
    batch has moved physically into that project. The remaining rules below
    cover product-owned files that still reside at historical Backend paths
    during the transitional move batches; do not compile a second copy into
    the host assembly.
  -->
  <ItemGroup>
    <Compile Remove="Services\BookAssetFormats.cs" />
    <Compile Remove="Services\BookLookupService.cs" />
    <Compile Remove="Services\IBookAssetStorage.cs" />
    <Compile Remove="Services\MediaMetadataService.cs" />
    <Compile Remove="Services\MediaTypeMap.cs" />
    <Compile Remove="Services\NoteProcessorService.cs" />
    <Compile Remove="Services\Knowledge\**\*.cs" />
    <Compile Remove="Services\Library\**\*.cs" />
    <Compile Remove="Services\Notes\**\*.cs" />
    <Compile Remove="Services\Portability\**\*.cs" />

    <Compile Remove="Services\Ai\AiProviderConfig.cs" />
    <Compile Remove="Services\Ai\ILlmProvider.cs" />
    <Compile Remove="Services\Ai\ISTtProvider.cs" />
    <Compile Remove="Services\Ai\IThoughtProcessor.cs" />
    <Compile Remove="Services\Ai\OpenAiCompatibleChatCompletions.cs" />
    <Compile Remove="Services\Ai\SttErrorCodes.cs" />
    <Compile Remove="Services\Ai\ThoughtProcessor.cs" />

    <Compile Remove="Integrations\Assistant\**\*.cs" />

    <Compile Remove="Providers\ProviderRegistry.cs" />
    <Compile Remove="Providers\Contracts\**\*.cs" />
    <Compile Remove="Providers\Acquisition\AcquisitionJobStatus.cs" />
    <Compile Remove="Providers\Acquisition\AcquisitionModels.cs" />
    <Compile Remove="Providers\Acquisition\AcquisitionOptions.cs" />
    <Compile Remove="Providers\Acquisition\AcquisitionService.cs" />
    <Compile Remove="Providers\Acquisition\ProviderContentDownloader.cs" />
    <Compile Remove="Providers\Acquisition\ProviderHostPolicy.cs" />
    <Compile Remove="Providers\Acquisition\TranscodeLimiter.cs" />
    <Compile Remove="Providers\Acquisition\Media\**\*.cs" />
    <Compile Remove="Providers\Discovery\**\*.cs" />
    <Compile Remove="Providers\Gutenberg\**\*.cs" />
    <Compile Remove="Providers\LibriVox\**\*.cs" />
    <Compile Remove="Providers\StandardEbooks\**\*.cs" />
    <Compile Remove="Providers\Wikisource\**\*.cs" />

    <Compile Remove="Endpoints\BooksEndpoints.cs" />
    <Compile Remove="Endpoints\ProviderEndpoints.cs" />
    <Compile Remove="Endpoints\ImportEndpoints.cs" />
    <Compile Remove="Endpoints\NotesEndpoints.cs" />
    <Compile Remove="Endpoints\NoteProcessingEndpoints.cs" />
    <Compile Remove="Endpoints\CollectionsEndpoints.cs" />
    <Compile Remove="Endpoints\TopicsEndpoints.cs" />
    <Compile Remove="Endpoints\WritingsEndpoints.cs" />
    <Compile Remove="Endpoints\TranscriptionEndpoints.cs" />
    <Compile Remove="Endpoints\AssistantEndpoints.cs" />
    <Compile Remove="Endpoints\AiProviderSettingsEndpoints.cs" />
    <Compile Remove="Endpoints\AssistantSettingsEndpoints.cs" />
    <Compile Remove="Endpoints\DeploymentCapabilitiesEndpoints.cs" />
    <Compile Remove="Endpoints\PortabilityEndpoints.cs" />
    <Compile Remove="Endpoints\OpdsEndpoints.cs" />
    <Compile Remove="Endpoints\LibraryHttpMapper.cs" />
    <Compile Remove="Endpoints\StoredAssetHttpResult.cs" />

    <Compile Remove="Health\NostosHealthChecks.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Storage\" />
    <Folder Include="Storage\books\" />
  </ItemGroup>



  <Target Name="BuildFrontend" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Release' And '$(SkipFrontendBuild)' != 'true' ">
    <Message Text="Building Angular Frontend (Release Mode)..." Importance="high" />

    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules') And '$(OS)' != 'Windows_NT'" />
    <Exec Command="npm.cmd install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules') And '$(OS)' == 'Windows_NT'" />

    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="npm.cmd run build" WorkingDirectory="$(SpaRoot)" Condition="'$(OS)' == 'Windows_NT'" />

    <ItemGroup>
      <FrontendFiles Include="$(SpaRoot)dist\Nostos.Frontend\browser\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>

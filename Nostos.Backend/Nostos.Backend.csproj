<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\Nostos.Frontend\</SpaRoot>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Security overrides for vulnerable transitives:
         Microsoft.OpenApi 2.0.0 -> 2.7.5 (GHSA-v5pm-xwqc-g5wc)
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 -> 3.53.3 (GHSA-2m69-gcr7-jv3q)
         System.Security.Cryptography.Pkcs 9.0.0 -> 10.0.13 (GHSA-846f-f764-76mx,
           GHSA-2fmv-rv2c-59x7), pulled in by the EF Core design-time tooling. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="z440.atl.core" Version="7.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Product\Nostos.Product.csproj" />
    <ProjectReference Include="..\Nostos.Shared\Nostos.Shared.csproj" />
  </ItemGroup>

  <!--
    Canonical product source for the 02.2 foundation, 02.3
    services/AI/assistant, 02.4 provider and 02.5 endpoint/health batches is
    physically owned and compiled by Nostos.Product.
  -->

  <ItemGroup>
    <Folder Include="Storage\" />
    <Folder Include="Storage\books\" />
  </ItemGroup>



  <Target Name="BuildFrontend" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Release' And '$(SkipFrontendBuild)' != 'true' ">
    <Message Text="Building Angular Frontend (Release Mode)..." Importance="high" />

    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules') And '$(OS)' != 'Windows_NT'" />
    <Exec Command="npm.cmd install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules') And '$(OS)' == 'Windows_NT'" />

    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="npm.cmd run build" WorkingDirectory="$(SpaRoot)" Condition="'$(OS)' == 'Windows_NT'" />

    <ItemGroup>
      <FrontendFiles Include="$(SpaRoot)dist\Nostos.Frontend\browser\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>

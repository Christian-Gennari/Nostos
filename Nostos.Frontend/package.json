{
  "name": "nostos.frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "e2e": "playwright test",
    "e2e:transfer": "playwright test --config playwright.library-transfer.config.ts",
    "e2e:launcher-check": "node e2e/support/launch-regression.mjs",
    "profile:fade": "node tools/profile-fade.mjs",
    "check:css": "node scripts/check-css-integrity.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check": "npm run check:css && npm run check:theme && npm run check:design",
    "capture:baseline": "node scripts/capture-baseline.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "probe:selection": "node scripts/probe-selection.mjs",
    "probe:editions-parity": "node scripts/probe-editions-parity.mjs",
    "check:pixels": "node scripts/check-pixels.mjs",
    "probe:iconbutton": "node scripts/probe-iconbutton.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^21.0.2",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@phosphor-icons/core": "^2.1.1",
    "d3-force": "^3.0.0",
    "epubjs": "^0.3.93",
    "graphology": "^0.26.0",
    "howler": "^2.2.4",
    "marked": "^17.0.1",
    "ngx-extended-pdf-viewer": "^25.6.1",
    "rxjs": "~7.8.0",
    "sigma": "^3.0.3",
    "tinymce": "^8.8.2",
    "tslib": "^2.3.0",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.2.19",
    "@modelcontextprotocol/sdk": "^1.14.0",
    "@playwright/test": "^1.56.0",
    "@types/d3-force": "^3.0.10",
    "@types/howler": "^2.2.12",
    "@types/turndown": "^5.0.6",
    "jsdom": "^27.1.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}

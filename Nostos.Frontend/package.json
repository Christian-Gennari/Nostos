{
  "name": "nostos.frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "e2e": "playwright test",
    "e2e:transfer": "playwright test --config playwright.library-transfer.config.ts",
    "e2e:launcher-check": "node e2e/support/launch-regression.mjs",
    "profile:fade": "node tools/profile-fade.mjs",
    "check:css": "node scripts/check-css-integrity.mjs",
    "check:design": "node --test scripts/design-guardrails.test.mjs && node scripts/check-design.mjs",
    "check": "npm run check:css && npm run check:theme && npm run check:design",
    "capture:baseline": "node scripts/capture-baseline.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "probe:selection": "node scripts/probe-selection.mjs",
    "probe:editions-parity": "node scripts/probe-editions-parity.mjs",
    "check:pixels": "node scripts/check-pixels.mjs",
    "probe:iconbutton": "node scripts/probe-iconbutton.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@phosphor-icons/core": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/swe": "^1.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "citeproc": "2.4.63",
    "d3-force": "^3.0.0",
    "docx": "9.14.0",
    "epubjs": "^0.3.93",
    "graphology": "^0.26.0",
    "howler": "^2.2.4",
    "marked": "^18.1.1",
    "ngx-extended-pdf-viewer": "^31.0.1",
    "rxjs": "~7.8.0",
    "sigma": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/d3-force": "^3.0.10",
    "@types/howler": "^2.2.13",
    "@types/turndown": "^5.0.6",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}

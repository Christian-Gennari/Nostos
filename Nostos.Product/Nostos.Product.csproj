<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- Reads uploaded KoboReader.sqlite files (highlight import). Core only:
         the host supplies the native SQLite library. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="z440.atl.core" Version="7.9.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Shared\Nostos.Shared.csproj" />
  </ItemGroup>

  <!--
    #459 establishes project ownership without a mass namespace/path rewrite.
    The 02.2 foundation and 02.3 services/AI/assistant batches are now physically
    owned by Nostos.Product and included by the SDK's default Compile items.
    The remaining entries below are provider, endpoint and health sources that
    stay at their historical Backend paths during the transitional move batches,
    but Nostos.Product is their only compiling project. Nostos.Backend references
    this project and explicitly removes those remaining linked files from its
    default Compile items, so there is one implementation rather than a copied
    facade.
  -->
  <ItemGroup>
    <Compile Include="..\Nostos.Backend\Providers\ProviderRegistry.cs" Link="Providers\ProviderRegistry.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Contracts\**\*.cs" Link="Providers\Contracts\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\AcquisitionJobStatus.cs" Link="Providers\Acquisition\AcquisitionJobStatus.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\AcquisitionModels.cs" Link="Providers\Acquisition\AcquisitionModels.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\AcquisitionOptions.cs" Link="Providers\Acquisition\AcquisitionOptions.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\AcquisitionService.cs" Link="Providers\Acquisition\AcquisitionService.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\ProviderContentDownloader.cs" Link="Providers\Acquisition\ProviderContentDownloader.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\ProviderHostPolicy.cs" Link="Providers\Acquisition\ProviderHostPolicy.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\TranscodeLimiter.cs" Link="Providers\Acquisition\TranscodeLimiter.cs" />
    <Compile Include="..\Nostos.Backend\Providers\Acquisition\Media\**\*.cs" Link="Providers\Acquisition\Media\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\Discovery\**\*.cs" Link="Providers\Discovery\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\Gutenberg\**\*.cs" Link="Providers\Gutenberg\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\LibriVox\**\*.cs" Link="Providers\LibriVox\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\StandardEbooks\**\*.cs" Link="Providers\StandardEbooks\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Nostos.Backend\Providers\Wikisource\**\*.cs" Link="Providers\Wikisource\%(RecursiveDir)%(Filename)%(Extension)" />

    <Compile Include="..\Nostos.Backend\Endpoints\BooksEndpoints.cs" Link="Endpoints\BooksEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\ProviderEndpoints.cs" Link="Endpoints\ProviderEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\ImportEndpoints.cs" Link="Endpoints\ImportEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\NotesEndpoints.cs" Link="Endpoints\NotesEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\NoteProcessingEndpoints.cs" Link="Endpoints\NoteProcessingEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\CollectionsEndpoints.cs" Link="Endpoints\CollectionsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\TopicsEndpoints.cs" Link="Endpoints\TopicsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\WritingsEndpoints.cs" Link="Endpoints\WritingsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\TranscriptionEndpoints.cs" Link="Endpoints\TranscriptionEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\AssistantEndpoints.cs" Link="Endpoints\AssistantEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\AiProviderSettingsEndpoints.cs" Link="Endpoints\AiProviderSettingsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\AssistantSettingsEndpoints.cs" Link="Endpoints\AssistantSettingsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\DeploymentCapabilitiesEndpoints.cs" Link="Endpoints\DeploymentCapabilitiesEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\PortabilityEndpoints.cs" Link="Endpoints\PortabilityEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\OpdsEndpoints.cs" Link="Endpoints\OpdsEndpoints.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\LibraryHttpMapper.cs" Link="Endpoints\LibraryHttpMapper.cs" />
    <Compile Include="..\Nostos.Backend\Endpoints\StoredAssetHttpResult.cs" Link="Endpoints\StoredAssetHttpResult.cs" />

    <Compile Include="..\Nostos.Backend\Health\NostosHealthChecks.cs" Link="Health\NostosHealthChecks.cs" />
  </ItemGroup>

</Project>

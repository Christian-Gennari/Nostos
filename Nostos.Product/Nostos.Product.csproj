<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- Reads uploaded KoboReader.sqlite files (highlight import). Core only:
         the host supplies the native SQLite library. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="z440.atl.core" Version="7.9.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Nostos.Backend.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The SelfHosted activation candidate database builder materializes the
         portable payload through the same internal relational restore the
         compatibility import endpoint uses, so the two paths cannot drift. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Nostos.Backend</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Shared\Nostos.Shared.csproj" />
  </ItemGroup>

  <!--
    The 02.2 foundation, 02.3 services/AI/assistant, 02.4 provider and 02.5
    endpoint/health batches are physically owned by Nostos.Product and included
    by the SDK's default Compile items.
  -->

</Project>
